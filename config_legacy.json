{
  "scenario_metadata": {
    "name": "New Zealand Spatial Production Risk",
    "phase_a_label": "Unaffected",
    "phase_b_label": "Incubating",
    "phase_c_label": "Active",
    "phase_d_label": "Lost production capacity",
    "production_type_label": "Production type",
    "region_label": "Region",
    "shelter_category_label": "Shelter category",
    "value_axis_label": "Total production capacity lost",
    "survival_axis_label": "Average final survival rate (%)",
    "sheltered_label": "Sheltered",
    "unsheltered_label": "Unsheltered"
  },
  "simulation_controls": {
    "monte_carlo_iterations": 500,
    "random_seed": 2026,
    "initial_phase_c_entities": 3,
    "starting_location_mode": "random",
    "iterations_per_starting_farm": 25
  },
  "input_data": {
    "file": "data/farms.csv",
    "use_row_count_for_population_size": false,
    "column_mappings": {
      "id": "farm_id",
      "lon": "longitude",
      "lat": "latitude",
      "barrier_group": "island",
      "region": "region",
      "production_type": "production_type",
      "is_sheltered": "is_sheltered",
      "production_yield": "production_yield"
    }
  },
  "model_parameters": {
    "population_size": 150,
    "simulation_days": 60,
    "spatial_decay_factor": 0.025,
    "cross_barrier_transmission_multiplier": 0.0,
    "incubation_period_days": 4,
    "active_period_days": 8
  },
  "production_metrics": {
    "average_bird_yield": 1000,
    "production_capacity_unit": "birds",
    "production_types": [
      { "type": "Eggs", "allocation_rate": 0.55 },
      { "type": "Meat", "allocation_rate": 0.45 }
    ]
  },
  "housing_attributes": {
    "barn_allocation_rate": 0.45,
    "barn_protection_efficiency": 0.70
  },
  "cull_response": {
    "compare_with_no_control": true,
    "coverage": 0.80,
    "response_delay_days": 1
  },
  "spatial_bounds": {
    "minimum_longitude": 166.0,
    "maximum_longitude": 179.0,
    "minimum_latitude": -47.5,
    "maximum_latitude": -34.0
  },
  "map_options": {
    "boundary_file": "data/nz_regional_council_2025.geojson",
    "show_region_boundaries": true
  }
}
